{
  "name": "thinker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "ingest:news": "node scripts/ingest-news.mjs",
    "ingest:scriptures": "node scripts/ingest-scriptures.mjs",
    "ingest:book-ideas": "node scripts/ingest-book-ideas.mjs",
    "ingest:philosophers": "node scripts/ingest-philosophers.mjs",
    "ingest:zenquotes": "node scripts/ingest-zenquotes.mjs",
    "ingest:black-history": "node scripts/ingest-black-history.mjs",
    "ingest": "npm run ingest:news && npm run ingest:scriptures && npm run ingest:book-ideas && npm run ingest:philosophers && npm run ingest:zenquotes && npm run ingest:black-history",
    "draft:ideas": "node scripts/draft-ideas.mjs",
    "promote:ideas": "node scripts/promote-ideas.mjs",
    "queue:seeds": "node scripts/queue-export.mjs seeds",
    "queue:promote": "node scripts/queue-export.mjs promote"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
